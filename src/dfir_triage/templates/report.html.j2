<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>DFIR Triage Report</title>
<style>
  :root {
    --bg: #ffffff; --fg: #1a1d21; --muted: #5b6470; --line: #dde1e6; --panel: #f5f7f9;
    --high: #b42318; --medium: #b54708; --low: #475467; --ok: #067647;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1115; --fg: #e6e8eb; --muted: #9aa3ad; --line: #2a2f36; --panel: #171a20;
      --high: #f97066; --medium: #fdb022; --low: #98a2b3; --ok: #47cd89;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg);
         font: 14px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
  main { max-width: 1200px; margin: 0 auto; padding: 24px 16px 48px; }
  h1 { font-size: 22px; margin: 0 0 4px; }
  h2 { font-size: 17px; margin: 32px 0 8px; border-bottom: 1px solid var(--line); padding-bottom: 4px; }
  .meta { color: var(--muted); font-size: 13px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-top: 16px; }
  .card { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 12px; }
  .card b { display: block; font-size: 22px; }
  .card span { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 13px; }
  th, td { text-align: left; vertical-align: top; padding: 6px 8px; border-bottom: 1px solid var(--line); }
  th { background: var(--panel); position: sticky; top: 0; }
  td.wrap { word-break: break-word; max-width: 420px; }
  code, .mono { font-family: ui-monospace, Consolas, monospace; font-size: 12px; }
  .sev { font-weight: 600; text-transform: uppercase; font-size: 12px; }
  .sev-high { color: var(--high); } .sev-medium { color: var(--medium); } .sev-low { color: var(--low); }
  .err { color: var(--high); } .ok { color: var(--ok); }
  .note { color: var(--muted); font-size: 12px; }
  pre.summary { white-space: pre-wrap; background: var(--panel); border: 1px solid var(--line);
                border-radius: 8px; padding: 12px; }
  a { color: inherit; }
</style>
</head>
<body>
<main>
  <h1>DFIR Triage Report</h1>
  <div class="meta">
    Evidence: <code>{{ evidence_dir }}</code> ·
    Generated {{ generated | ts }} · dfir-triage {{ version }} · All times UTC
  </div>

  <div class="cards">
    <div class="card"><b>{{ total_events }}</b><span>Timeline events</span></div>
    <div class="card"><b class="sev-high">{{ severity_counts.high }}</b><span>High findings</span></div>
    <div class="card"><b class="sev-medium">{{ severity_counts.medium }}</b><span>Medium findings</span></div>
    <div class="card"><b class="sev-low">{{ severity_counts.low }}</b><span>Low findings</span></div>
    <div class="card"><b>{{ artifacts | length }}</b><span>Artifacts ({{ failed_artifacts }} failed)</span></div>
  </div>
  {% if first_seen %}
  <p class="meta">Evidence spans {{ first_seen | ts }} → {{ last_seen | ts }}</p>
  {% endif %}

  <h2>Findings</h2>
  {% if findings %}
  <p class="note">Deterministic rules, no LLM. A finding means "look at this", not "this is malicious".</p>
  <div class="scroll"><table>
    <tr><th>Severity</th><th>Rule</th><th>ATT&amp;CK</th><th>Time</th><th>Host / user</th><th>Evidence</th></tr>
    {% for f in findings %}
    <tr>
      <td class="sev sev-{{ f.rule.severity }}">{{ f.rule.severity }}</td>
      <td><b>{{ f.rule.id }}</b> {{ f.rule.title }}<div class="note">{{ f.rule.note }}</div></td>
      <td><a href="{{ attack_url(f.rule.technique_id) }}">{{ f.rule.technique_id }}</a>
          <div class="note">{{ f.rule.tactic }}</div></td>
      <td class="mono">{{ f.event.timestamp | ts }}<div class="note">{{ f.event.time_meaning }}</div></td>
      <td>{{ f.event.host or "" }}<div class="note">{{ f.event.user or "" }}</div></td>
      <td class="wrap">{{ f.event.description }}
        {% if f.event.path %}<div class="mono">{{ f.event.path }}</div>{% endif %}
        <div class="note mono">{{ f.event.source }}{% if f.event.event_id is not none %} · EID {{ f.event.event_id }}{% endif %}</div></td>
    </tr>
    {% endfor %}
  </table></div>
  {% else %}
  <p class="ok">No rule matched. That is not proof the system is clean: check artifact coverage below.</p>
  {% endif %}

  {% if summary %}
  <h2>LLM summary (advisory)</h2>
  <p class="note">Generated by a language model from the timeline and findings. It can be wrong, and the evidence it read is untrusted. Verify against the findings above.</p>
  <pre class="summary">{{ summary }}</pre>
  {% endif %}

  <h2>Artifact coverage</h2>
  <div class="scroll"><table>
    <tr><th>Artifact</th><th>Type</th><th>Events</th><th>Status</th></tr>
    {% for a in artifacts %}
    <tr>
      <td class="mono wrap">{{ a.path }}</td><td>{{ a.kind }}</td><td>{{ a.events }}</td>
      <td>{% if a.error %}<span class="err">{{ a.error }}</span>{% else %}<span class="ok">parsed</span>{% endif %}</td>
    </tr>
    {% else %}
    <tr><td colspan="4">No recognised artifacts found.</td></tr>
    {% endfor %}
  </table></div>

  <h2>Timeline</h2>
  {% if truncated %}
  <p class="note">Showing the first {{ events | length }} of {{ total_events }} events. The full timeline is in timeline.csv.</p>
  {% endif %}
  <div class="scroll"><table>
    <tr><th>Time (UTC)</th><th>Meaning</th><th>Source</th><th>EID</th><th>Host</th><th>User</th><th>Description / path</th></tr>
    {% for e in events %}
    <tr>
      <td class="mono">{{ e.timestamp | ts }}</td><td class="note">{{ e.time_meaning }}</td>
      <td>{{ e.source }}</td><td>{{ e.event_id if e.event_id is not none else "" }}</td>
      <td>{{ e.host or "" }}</td><td>{{ e.user or "" }}</td>
      <td class="wrap">{{ e.description }}{% if e.path %}<div class="mono">{{ e.path }}</div>{% endif %}</td>
    </tr>
    {% endfor %}
  </table></div>
</main>
</body>
</html>
